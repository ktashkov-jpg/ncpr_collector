# Copy to .env and adjust. Nothing here is a secret: access to the NCPR
# service is granted by source-IP allowlisting, not by credentials.

# Host directory holding the SQLite state, raw XML archive and exports.
DATA_ROOT=/srv/ncpr-collector/data

# Match the host user so files on the volume are not root-owned.
HOST_UID=1000
HOST_GID=1000

# --- service (runbook §2) ---
NCPR_ENDPOINT=https://portal.ncpr.bg:443/registers/MedicinalProductsRegistersService
NCPR_NAMESPACE=http://webservice.portal.ncprmp.sirma.com

# --- request policy (runbook §9) ---
# These defaults are conservative on purpose. Raising them without written
# rate guidance from NCPR risks the allowlist, which is the only access path.
NCPR_DELAY_MIN_S=300
NCPR_DELAY_MAX_S=600
NCPR_DAILY_CAP=80
NCPR_WINDOW_START_HOUR=8
NCPR_WINDOW_END_HOUR=18
NCPR_TIMEOUT_S=60

# Leave at 0. Set to 1 only if the host CA store genuinely cannot be fixed;
# the image installs ca-certificates precisely so this stays off.
NCPR_INSECURE_TLS=0
