# Copy to .env and adjust. Nothing here is a secret: access to the NCPR
# service is granted by source-IP allowlisting, not by credentials.

# --- storage: two roots, for two different jobs ---
#
# DB_ROOT holds SQLite + lock + HALTED. Put it on a LOCAL filesystem
# (ext4/xfs/zfs/btrfs). This file carries the daily counter that enforces
# the rate cap, and SQLite needs working POSIX locks -- a CIFS/SMB mount
# can corrupt it, and a corrupted counter means uncontrolled request volume
# against an IP-allowlisted service.
DB_ROOT=/var/lib/ncpr-collector

# ARCHIVE_ROOT holds raw XML, exports and the cached WSDL. Append-only, so
# a shared folder is fine and is the point: the harvest stays readable and
# copyable without touching the collector. Defaults to DB_ROOT if unset.
ARCHIVE_ROOT=/Workhorse_Mirror/Room_305/Kosi/Konstantin/Projects/ncpr_collector

# Match the identity that owns BOTH directories. The container drops to this
# uid, so a root-owned volume is unwritable. On OMV, a shared folder is
# usually root:users -- `users` is GID 100 on Debian, not 1000. Check with
# `ls -ln` on the shared folder and match what you see.
HOST_UID=1000
HOST_GID=100

# --- service (runbook §2) ---
NCPR_ENDPOINT=https://portal.ncpr.bg:443/registers/MedicinalProductsRegistersService
NCPR_NAMESPACE=http://webservice.portal.ncprmp.sirma.com

# --- request policy (runbook §9) ---
# These defaults are conservative on purpose. Raising them without written
# rate guidance from NCPR risks the allowlist, which is the only access path.
NCPR_DELAY_MIN_S=300
NCPR_DELAY_MAX_S=600
NCPR_DAILY_CAP=80
NCPR_WINDOW_START_HOUR=8
NCPR_WINDOW_END_HOUR=18
NCPR_TIMEOUT_S=60

# Leave at 0. Set to 1 only if the host CA store genuinely cannot be fixed;
# the image installs ca-certificates precisely so this stays off.
NCPR_INSECURE_TLS=0

# --- private pharmacist web interface ---
# Generate once on the deployment host, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep this stable across restarts. It is a secret and belongs only in .env.
NCPR_WEB_SECRET=replace-with-a-random-64-character-value

# Keep locked until written NCPR launch/rate approval is on file.
NCPR_BULK_APPROVED=0
